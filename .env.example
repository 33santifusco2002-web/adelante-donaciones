# ============================================================
# Variables de entorno – copiar a .env.local y completar
# ============================================================

# --- Mercado Pago (SOLO servidor, nunca se exponen al navegador) ---
# Si MP_ACCESS_TOKEN está vacío, el pago se SIMULA (modo boceto).
# Prueba: credenciales de prueba (TEST-...) de Tus integraciones > tu app > Credenciales de prueba.
# Producción: credenciales de producción (APP_USR-...).
MP_ACCESS_TOKEN=
# Clave pública (hoy no se usa en el cliente; queda lista para Checkout Bricks).
MP_PUBLIC_KEY=
# Clave secreta de webhooks (Tus integraciones > Webhooks > Clave secreta). Valida x-signature.
MP_WEBHOOK_SECRET=

# --- Sitio ---
# URL pública sin barra final. Se usa en back_urls, webhooks y Open Graph.
# Mercado Pago exige https y no acepta localhost para las URLs de retorno.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Medición (opcional: si están vacías no se carga nada) ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# --- Boceto ---
# true = muestra la franja "Boceto de propuesta – datos de ejemplo".
NEXT_PUBLIC_DEMO_MODE=true
